{
  "name": "insight-log",
  "version": "0.1.0",
  "description": "Lightweight cross-platform log search desktop application",
  "author": "zyf8827",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zyf8827/insight-log.git"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:app": "tauri dev",
    "build:app": "tauri build --no-bundle",
    "build:bundle": "tauri build",
    "scripts:dev": "bash ./scripts/dev.sh",
    "scripts:build": "bash ./scripts/build.sh",
    "scripts:build-linux": "bash ./scripts/build-linux.sh",
    "scripts:build-macos": "bash ./scripts/build-macos.sh",
    "scripts:build-windows": "bash ./scripts/build-windows.sh",
    "scripts:build-windows-bat": "scripts\\\\build-windows.bat",
    "scripts:build-windows-ps1": "powershell -ExecutionPolicy Bypass -File scripts\\\\build-windows.ps1"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@uiw/react-codemirror": "^4.25.2",
    "antd": "^5.27.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.8.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
